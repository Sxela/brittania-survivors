{
  "name": "britannia-survivors",
  "version": "0.9.19",
  "private": true,
  "type": "module",
  "description": "Britannia Survivors source; game resources are generated locally from your own client",
  "scripts": {
    "assets:setup": "python tools/setup-assets.py",
    "desktop:dist": "node tools/build-desktop.mjs",
    "test:ci": "node tools/test-ci.mjs",
    "start": "node tools/serve.mjs",
    "mobile": "node tools/start-mobile.mjs",
    "mobile:build": "node tools/build-mobile.mjs",
    "desktop": "node tools/run-electron.cjs",
    "desktop:stage": "node tools/stage-desktop.mjs",
    "desktop:audit": "node tools/audit-desktop.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  }
}
